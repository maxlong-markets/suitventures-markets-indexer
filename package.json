{
  "name": "suitventures-markets-indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "codegen": "envio codegen",
    "dev": "envio dev",
    "start": "envio start",
    "test": "vitest run --test-timeout=20000 --passWithNoTests",
    "test:live": "ENVIO_LIVE_TEST=1 vitest run --test-timeout=120000 src/live",
    "typecheck": "tsc --noEmit",
    "block-at": "node --env-file-if-exists=.env scripts/block-at.ts",
    "build-quotes": "node --env-file-if-exists=.env scripts/build-quotes.ts",
    "resolve-feeds": "node --env-file-if-exists=.env scripts/resolve-feeds.ts"
  },
  "dependencies": {
    "envio": "3.10.0",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "@uniswap/v3-sdk": "^3.20.0",
    "jsbi": "^3.2.5",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.1.0"
  }
}
