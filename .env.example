# https://envio.dev/app/api-tokens
ENVIO_API_TOKEN=
# Robinhood Chain RPC for token metadata reads and the scripts. Required: a
# keyed RPC (Alchemy or similar) — the public RPC rate-limits metadata reads.
ENVIO_RPC_URL=
# Candle creation windows (spec section 5). Compute with: npm run block-at -- <unix seconds>
ENVIO_CANDLES_1M_START_BLOCK=
ENVIO_CANDLES_5M_START_BLOCK=
