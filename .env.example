# https://envio.dev/app/api-tokens
ENVIO_API_TOKEN=
# Robinhood Chain RPC for token metadata reads and the scripts (Alchemy in production).
ENVIO_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Candle creation windows (spec section 5). Compute with: npm run block-at -- <unix seconds>
ENVIO_CANDLES_1M_START_BLOCK=
ENVIO_CANDLES_5M_START_BLOCK=
